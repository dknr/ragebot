[Unit]
Description=RageBot Matrix Chat Reactor
After=network.target

[Service]
Type=simple
User=ragebot
WorkingDirectory=/srv/ragebot
ExecStart=/usr/local/bin/ragebot -config /etc/ragebot/config.json
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ragebot

[Install]
WantedBy=multi-user.target
