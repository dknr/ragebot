[Unit]
Description=RageBot Telegram Message Logger
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory={{RAGEBOT_DIR}}
Environment=PATH={{VENV_PATH}}/bin
ExecStart={{VENV_PATH}}/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ragebot

[Install]
WantedBy=multi-user.target